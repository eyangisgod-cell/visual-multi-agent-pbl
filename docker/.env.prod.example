# Production Environment Variables
# Copy this file to .env.prod and fill in your production values

# =========================================
# Database (PostgreSQL)
# =========================================
POSTGRES_DB=pbl_platform
POSTGRES_USER=your_production_db_user
POSTGRES_PASSWORD=your_secure_production_password

# Database connection URL format:
# postgresql://user:password@host:port/database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# =========================================
# Redis
# =========================================
REDIS_URL=redis://redis:6379

# =========================================
# MinIO (Object Storage)
# =========================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your_production_minio_key
MINIO_SECRET_KEY=your_secure_production_minio_secret
MINIO_ROOT_USER=${MINIO_ACCESS_KEY}
MINIO_ROOT_PASSWORD=${MINIO_SECRET_KEY}

# =========================================
# NextAuth (Authentication)
# =========================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate_this_with_openssl_rand_base64_32
NEXTAUTH_URL=https://your-production-domain.com

# =========================================
# JWT Secret
# =========================================
# Generate with: openssl rand -base64 48
JWT_SECRET=generate_this_with_openssl_rand_base64_48

# =========================================
# LLM Provider
# =========================================
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here

# =========================================
# CORS (if needed)
# =========================================
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
