generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username        String?       @unique @db.VarChar(50)
  password_hash   String?       @db.VarChar(255)
  nickname        String?       @db.VarChar(50)
  avatar_url      String?
  grade           Int?
  invitation_code String        @unique @db.VarChar(10)
  invited_by      String?       @db.Uuid
  points          Int?          @default(0)
  level           Int?          @default(1)
  abilities       Json?         @default("{}")
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?     @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?     @db.Timestamptz(6)
  role            String?       @default("USER") @db.VarChar(20)
  works           Work[]
  comments        WorkComment[]
  assignedTasks   ProjectTask[] @relation("AssignedTasks")
  likes           WorkLike[]
  WorkReview      WorkReview[]
  notifications   Notification[]
  wechatBindings  WechatBinding[]

  @@index([invitation_code], map: "idx_users_invitation_code")
  @@index([username], map: "idx_users_username")
  @@map("users")
}

model Session {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  token       String    @unique @db.VarChar(255)
  device_info Json?
  ip_address  String?   @db.Inet
  expires_at  DateTime  @db.Timestamptz(6)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expires_at], map: "idx_sessions_expires_at")
  @@index([token], map: "idx_sessions_token")
  @@map("sessions")
}

model Agent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(100)
  agentType   String    @unique @map("agent_type") @db.VarChar(50)
  description String?
  personality Json?
  skills      Json?
  avatarUrl   String?   @map("avatar_url")
  sprite_url  String?
  isPlatform  Boolean?  @default(true) @map("is_platform")
  is_active   Boolean?  @default(true)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("agents")
}

model UserAgent {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  agentId           String    @map("agent_id") @db.Uuid
  customName        String?   @map("custom_name") @db.VarChar(100)
  customConfig      Json?     @map("custom_config")
  short_term_memory Json?
  long_term_memory  Json?
  trust_level       Int?      @default(0)
  usage_count       Int?      @default(0)
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([userId, agentId])
  @@index([userId], map: "idx_user_agents_user_id")
  @@map("user_agents")
}

model Project {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String        @db.VarChar(255)
  description       String?
  cover_image_url   String?
  gradeMin          Int?          @map("grade_min")
  gradeMax          Int?          @map("grade_max")
  subject           String?       @db.VarChar(50)
  tags              String[]
  difficulty        Int?          @default(1)
  estimated_minutes Int?
  status            String?       @default("draft") @db.VarChar(20)
  is_premium        Boolean?      @default(false)
  created_by        String?       @db.Uuid
  completed_count   Int?          @default(0)
  like_count        Int?          @default(0)
  rubricCriteria    Json?         @map("rubric_criteria")
  createdAt         DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tasks             ProjectTask[]
  works             Work[]

  @@index([gradeMin, gradeMax], map: "idx_projects_grade")
  @@index([subject], map: "idx_projects_subject")
  @@map("projects")
}

model ProjectTask {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  title             String    @db.VarChar(255)
  description       String?
  orderIndex        Int       @map("order_index")
  agentType         String?   @map("agent_type") @db.VarChar(50)
  expected_output   String?
  rubric            Json?
  prerequisites     String[]  @db.Uuid
  assignedTo        String?   @map("assigned_to") @db.Uuid
  dueDate           DateTime? @map("due_date") @db.Timestamptz(6)
  status            String?   @default("todo") @db.VarChar(20)
  rubricScores      Json?     @map("rubric_scores")
  submissionContent String?   @map("submission_content") @db.Text
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  project           Project   @relation(fields: [projectId], references: [id])
  assignedUser      User?     @relation(fields: [assignedTo], references: [id], name: "AssignedTasks")

  @@index([projectId], map: "idx_project_tasks_project_id")
  @@index([assignedTo], map: "idx_project_tasks_assigned_to")
  @@map("project_tasks")
}

model Work {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String        @db.VarChar(255)
  description   String?
  coverImageUrl String?       @map("cover_image_url") @db.VarChar(500)
  content       String?
  status        String?       @default("draft") @db.VarChar(20) // draft, pending_review, published, rejected
  score         Int?          @default(0)
  is_premium    Boolean?      @default(false)
  projectId     String        @map("project_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  createdAt     DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  project       Project       @relation(fields: [projectId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  comments      WorkComment[]
  likes         WorkLike[]
  reviews       WorkReview[]

  @@index([projectId], map: "idx_works_project_id")
  @@index([userId], map: "idx_works_user_id")
  @@index([status], map: "idx_works_status")
  @@map("works")
}

model WorkComment {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content   String
  workId    String        @map("work_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  parentId  String?       @map("parent_id") @db.Uuid
  createdAt DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  work      Work          @relation(fields: [workId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
  parent    WorkComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   WorkComment[] @relation("CommentReplies")

  @@index([workId], map: "idx_work_comments_work_id")
  @@map("work_comments")
}

model WorkLike {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workId    String   @map("work_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  work      Work     @relation(fields: [workId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([workId, userId])
  @@index([workId], map: "idx_work_likes_work_id")
  @@map("work_likes")
}

model WorkReview {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workId    String   @map("work_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int?     @map("rating") @db.Integer // 1-5 分，可选
  comment   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([workId], map: "idx_work_reviews_work_id")
  @@index([userId], map: "idx_work_reviews_user_id")
  @@map("work_reviews")
}

model AgentMemory {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId      String     @map("agent_id") @db.Uuid
  userId       String?    @map("user_id") @db.Uuid
  type         MemoryType @map("type")
  content      String
  embedding    Json?      @map("embedding")
  importance   Int?       @default(1) @map("importance")
  tags         String[]   @map("tags")
  metadata     Json?      @map("metadata")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime?  @map("expires_at") @db.Timestamptz(6)
  consolidated Boolean    @default(false) @map("consolidated")

  @@index([agentId], map: "idx_agent_memories_agent_id")
  @@index([userId], map: "idx_agent_memories_user_id")
  @@index([type], map: "idx_agent_memories_type")
  @@index([consolidated], map: "idx_agent_memories_consolidated")
  @@map("agent_memories")
}

model AgentEvolution {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId       String        @map("agent_id") @db.Uuid
  userId        String?       @map("user_id") @db.Uuid
  evolutionType EvolutionType @map("evolution_type")
  description   String
  beforeState   Json?         @map("before_state")
  afterState    Json?         @map("after_state")
  triggerEvent  String?       @map("trigger_event")
  metadata      Json?         @map("metadata")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([agentId], map: "idx_agent_evolution_agent_id")
  @@index([userId], map: "idx_agent_evolution_user_id")
  @@index([evolutionType], map: "idx_agent_evolution_type")
  @@map("agent_evolution")
}

model AgentAvatar {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId     String   @map("agent_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  bodyType    String   @map("body_type") @db.VarChar(50)
  bodyColor   String   @map("body_color") @db.VarChar(7)
  headShape   String   @map("head_shape") @db.VarChar(50)
  hairstyle   String   @map("hairstyle") @db.VarChar(50)
  hairColor   String   @map("hair_color") @db.VarChar(7)
  eyes        String   @db.VarChar(50)
  eyeColor    String   @map("eye_color") @db.VarChar(7)
  mouth       String   @db.VarChar(50)
  outfit      String   @db.VarChar(50)
  outfitColor String   @map("outfit_color") @db.VarChar(7)
  accessories String[] @db.VarChar(255)
  metadata    Json?    @map("metadata")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([agentId, userId])
  @@index([agentId], map: "idx_agent_avatar_agent_id")
  @@index([userId], map: "idx_agent_avatar_user_id")
  @@map("agent_avatars")
}

// LLM 配置表
model LlmConfig {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider  String   @unique @db.VarChar(50)
  apiKey    String   @db.VarChar(500)
  baseUrl   String?  @db.VarChar(500)
  models    Json?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([provider], map: "idx_llm_configs_provider")
  @@map("llm_configs")
}

// 智能体配置表
model AgentConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentType   String   @unique @map("agent_type") @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  personality Json?
  skills      Json?
  appearance  Json?
  isEnabled   Boolean  @default(true) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([agentType], map: "idx_agent_configs_agent_type")
  @@map("agent_configs")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  username   String?  @map("username") @db.VarChar(50)
  metadata   Json?    @map("metadata")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([action], map: "idx_audit_logs_action")
  @@index([entityType], map: "idx_audit_logs_entity_type")
  @@index([entityId], map: "idx_audit_logs_entity_id")
  @@index([userId], map: "idx_audit_logs_user_id")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@map("audit_logs")
}

// 安全日志表 - 记录安全相关事件
model SecurityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(50) // sql_injection, xss, csrf_failure, rate_limit, auth_failure
  severity    String   @db.VarChar(20) // low, medium, high, critical
  description String   @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  userId      String?  @map("user_id") @db.Uuid
  requestPath String?  @map("request_path") @db.VarChar(500)
  requestBody Json?    @map("request_body")
  metadata    Json?    @map("metadata")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventType], map: "idx_security_logs_event_type")
  @@index([severity], map: "idx_security_logs_severity")
  @@index([ipAddress], map: "idx_security_logs_ip_address")
  @@index([userId], map: "idx_security_logs_user_id")
  @@index([createdAt], map: "idx_security_logs_created_at")
  @@map("security_logs")
}

// RBAC 角色表
model AdminRole {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  permissions Json?    @default("[]") @db.JsonB // 权限 key 数组
  isBuiltIn   Boolean  @default(false) @map("is_built_in")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([name], map: "idx_admin_roles_name")
  @@map("admin_roles")
}

// 对话表 - 用于存储用户与智能体的对话历史
model Conversation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  agentId   String    @map("agent_id") @db.Uuid
  title     String?   @db.VarChar(255)
  metadata  Json?     @map("metadata")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  messages  Message[]

  @@index([userId], map: "idx_conversations_user_id")
  @@index([agentId], map: "idx_conversations_agent_id")
  @@map("conversations")
}

// 消息表 - 存储对话中的具体消息
model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           MessageRole  // user, assistant, system
  content        String       @db.Text
  metadata       Json?        @map("metadata")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "idx_messages_conversation_id")
  @@index([createdAt], map: "idx_messages_created_at")
  @@map("messages")
}

enum Role {
  USER
  ADMIN
}

enum MemoryType {
  SHORT_TERM
  LONG_TERM
  EPISODIC
  PROCEDURAL
  SEMANTIC
}

enum EvolutionType {
  PERSONALITY_UPDATE
  SKILL_ACQUISITION
  BEHAVIOR_ADJUSTMENT
  KNOWLEDGE_EXPANSION
  PREFERENCE_CHANGE
}

enum MessageRole {
  user
  assistant
  system
}

// 知识库文档表 - 用于 RAG 系统
model KnowledgeDocument {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String   @db.VarChar(255)
  content   String   @db.Text
  category  String?  @db.VarChar(100)
  tags      String[]
  metadata  Json?    @map("metadata")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category], map: "idx_knowledge_documents_category")
  @@index([createdAt], map: "idx_knowledge_documents_created_at")
  @@map("knowledge_documents")
}

// 知识库分类表
model KnowledgeCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  parentId    String?  @db.Uuid
  parent      KnowledgeCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    KnowledgeCategory[] @relation("CategoryHierarchy")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([parentId], map: "idx_knowledge_categories_parent_id")
  @@map("knowledge_categories")
}

// 场景模板表 - 用于游戏场景配置
model Scene {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  elements    Json?    // 场景元素配置
  resources   Json?    // 关联资源
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive], map: "idx_scenes_is_active")
  @@map("scenes")
}

// 系统设置表 - 用于存储各种系统配置
model SystemSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     Json?
  category  String?  @db.VarChar(50)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([category], map: "idx_system_settings_category")
  @@map("system_settings")
}

// 通知表 - 用于系统通知
model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  type        NotificationType @default(info) @map("type")
  title       String           @db.VarChar(255)
  content     String           @db.Text
  isRead      Boolean          @default(false) @map("is_read")
  actionUrl   String?          @map("action_url") @db.VarChar(500)
  metadata    Json?            @map("metadata")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt      DateTime?        @map("read_at") @db.Timestamptz(6)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_notifications_user_id")
  @@index([isRead], map: "idx_notifications_is_read")
  @@index([createdAt], map: "idx_notifications_created_at")
  @@map("notifications")
}

enum NotificationType {
  info
  success
  warning
  error
  task
  system
  achievement
}

// 积分记录表 - 记录用户积分变动
model PointsLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  points      Int      // 积分变化量（正数增加，负数减少）
  balance     Int      // 变动后的积分余额
  action      String   @db.VarChar(50) // 积分动作类型：login, daily_bonus, submit_work, work_approved, work_rejected, manual_adjustment
  description String   @db.Text
  metadata    Json?    @map("metadata") // 额外元数据
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "idx_points_logs_user_id")
  @@index([action], map: "idx_points_logs_action")
  @@index([createdAt], map: "idx_points_logs_created_at")
  @@map("points_logs")
}

// 积分规则配置表
model PointsRule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action      String   @unique @db.VarChar(50) // 积分动作类型
  points      Int      // 积分数值
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  metadata    Json?    @map("metadata")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([action], map: "idx_points_rules_action")
  @@map("points_rules")
}

// 用户等级配置表
model UserLevel {
  level       Int    @id
  name        String @db.VarChar(50) // 等级名称
  minPoints   Int    @map("min_points") // 最低积分要求
  maxPoints   Int?   @map("max_points") // 最高积分要求（可选，最高等级可为空）
  privileges  Json?  @map("privileges") // 等级特权
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_levels")
}

// 微信 OAuth 配置表
model WechatConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appId       String   @db.VarChar(100) // 微信公众号/开放平台 AppID
  appSecret   String   @db.VarChar(500) // 微信公众号/开放平台 AppSecret
  token       String?  @db.VarChar(500) // 微信公众号 Token
  encodingAesKey String? @db.VarChar(500) // 微信公众号 EncodingAESKey
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive], map: "idx_wechat_configs_is_active")
  @@map("wechat_configs")
}

// 微信用户绑定表
model WechatBinding {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  wechatOpenid String  @unique @map("wechat_openid") @db.VarChar(100) // 微信 OpenID
  wechatUnionid String? @db.VarChar(100) // 微信 UnionID（跨应用唯一）
  nickname    String?  @db.VarChar(100) // 微信昵称
  avatarUrl   String?  @map("avatar_url") @db.VarChar(500) // 微信头像
  gender      Int?     // 性别：0-未知，1-男，2-女
  language    String?  @db.VarChar(20) // 语言
  city        String?  @db.VarChar(50) // 城市
  province    String?  @db.VarChar(50) // 省份
  country     String?  @db.VarChar(50) // 国家
  accessToken String?  @db.VarChar(1000) // 微信访问令牌（用于刷新用户信息）
  refreshToken String? @db.VarChar(1000) // 刷新令牌
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(6) // 令牌过期时间
  boundAt     DateTime @default(now()) @map("bound_at") @db.Timestamptz(6)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_wechat_bindings_user_id")
  @@index([wechatOpenid], map: "idx_wechat_bindings_wechat_openid")
  @@index([wechatUnionid], map: "idx_wechat_bindings_wechat_unionid")
  @@map("wechat_bindings")
}

// 微信登录会话表 - 用于扫码登录临时会话
model WechatLoginSession {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionKey  String   @unique @map("session_key") @db.VarChar(100) // 临时会话 key
  wechatOpenid String? @db.VarChar(100) // 扫码后的微信 OpenID
  status      String   @default("pending") @db.VarChar(20) // pending, scanned, confirmed, expired, used
  expiresAt   DateTime @db.Timestamptz(6) // 会话过期时间
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sessionKey], map: "idx_wechat_login_sessions_session_key")
  @@index([status], map: "idx_wechat_login_sessions_status")
  @@map("wechat_login_sessions")
}

// 文件上传分片表 - 用于大文件分片上传和断点续传
model UploadChunk {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileHash    String   @map("file_hash") @db.VarChar(64) // 文件 SHA256 哈希
  chunkIndex  Int      @map("chunk_index") // 分片索引（从 0 开始）
  totalChunks Int      @map("total_chunks") // 总分片数
  fileName    String   @map("file_name") @db.VarChar(255) // 原始文件名
  mimeType    String?  @map("mime_type") @db.VarChar(255) // 文件 MIME 类型
  fileSize    Int?     @map("file_size") // 分片大小（字节）
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  @@index([fileHash], map: "idx_upload_chunks_file_hash")
  @@index([fileHash, chunkIndex], map: "idx_upload_chunks_file_hash_chunk_index")
  @@map("upload_chunks")
}
