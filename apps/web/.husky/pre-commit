#!/bin/bash
# .husky/pre-commit
# 前端预提交检查（MVP 阶段 - 只警告不阻止）

set -e

# 获取脚本所在目录（支持 worktree）
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WEB_DIR="$SCRIPT_DIR"

# 如果在根目录的 .husky 中运行，切换到 apps/web
if [ ! -f "$WEB_DIR/package.json" ]; then
    WEB_DIR="$(cd "$(dirname "$0")/../apps/web" && pwd)"
fi

cd "$WEB_DIR"

echo "=== Running pre-commit checks (MVP phase - warnings only) ==="
echo ""

# 1. ESLint（自动修复，只警告）
echo "1️⃣  Running ESLint..."
npm run lint:fix --quiet || {
    echo "⚠️  ESLint 仍有未修复的问题"
    echo "   建议运行：npm run lint:fix"
}
echo ""

# 2. TypeScript 类型检查（只警告，不阻止）
echo "2️⃣  Running TypeScript check..."
npx tsc --noEmit 2>&1 | head -20 || {
    echo ""
    echo "⚠️  TypeScript 类型错误（MVP 阶段不阻止提交）"
    echo "   提示：运行 'npx tsc --noEmit' 查看详细错误"
}
echo ""

echo "=== Pre-commit checks completed (warnings only) ==="
echo ""
echo "✅ 预提交检查完成（MVP 阶段只警告）"
echo ""
echo "推送前建议运行本地完整检查："
echo "  bash scripts/local-ci-check.sh"
echo ""
