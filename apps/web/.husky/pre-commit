#!/bin/bash
# .husky/pre-commit
# 前端预提交检查（优化版 - 只警告不阻止）

set -e

# 获取脚本所在目录（支持 worktree）
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WEB_DIR="$SCRIPT_DIR"

# 如果在根目录的 .husky 中运行，切换到 apps/web
if [ ! -f "$WEB_DIR/package.json" ]; then
    WEB_DIR="$(cd "$(dirname "$0")/../apps/web" && pwd)"
fi

cd "$WEB_DIR"

echo "=== Running pre-commit checks (warning only) ==="

# ESLint（自动修复，不阻止提交）
echo "[1/3] Running ESLint (auto-fix)..."
npm run lint:fix --quiet || {
    echo "⚠️  ESLint 仍有未修复的问题，建议运行 'npm run lint:fix'"
}

# TypeScript 类型检查（只警告，不阻止）
echo "[2/3] Running TypeScript check (warning only)..."
npx tsc --noEmit 2>&1 | head -20 || {
    echo ""
    echo "⚠️  TypeScript 类型错误（不阻止提交）"
    echo "提示：运行 'npx tsc --noEmit' 查看详细错误"
}

# Prettier 格式化
echo "[3/3] Running Prettier..."
npx prettier --write "src/**/*.{ts,tsx}" --log-level=warn || true

echo ""
echo "=== Pre-commit checks completed (warnings only) ==="
echo ""
echo "提示：以上错误不会阻止提交，但建议在推送前修复"
echo "推送前运行：bash scripts/quick-check.sh"
