#!/bin/bash
# .husky/pre-commit
# 前端预提交检查

set -e

# 获取脚本所在目录（支持 worktree）
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WEB_DIR="$SCRIPT_DIR"

# 如果在根目录的 .husky 中运行，切换到 apps/web
if [ ! -f "$WEB_DIR/package.json" ]; then
    WEB_DIR="$(cd "$(dirname "$0")/../apps/web" && pwd)"
fi

cd "$WEB_DIR"

echo "=== Running pre-commit checks ==="

# ESLint（快速检查）
echo "Running ESLint..."
npm run lint --quiet || {
    echo ""
    echo "⚠️  ESLint 检查未通过"
    echo "建议运行：npm run lint:fix"
    echo ""
    # 不阻止提交，只是警告
}

# TypeScript 类型检查（快速）
echo "Running TypeScript check..."
npx tsc --noEmit || {
    echo ""
    echo "❌ TypeScript 类型错误"
    echo "请修复类型错误后重新提交"
    echo ""
    exit 1
}

echo "=== Pre-commit checks passed ==="
